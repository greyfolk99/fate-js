{
  "name": "fate-js",
  "version": "0.3.0",
  "type": "module",
  "description": "사주팔자(四柱) 계산 라이브러리.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greyfolk99/fate-js.git"
  },
  "keywords": [
    "bazi",
    "saju",
    "사주",
    "팔자",
    "만세력",
    "절기",
    "fortune"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}